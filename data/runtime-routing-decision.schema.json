{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlisinaDevelo/md-files/schema/runtime/routing-decision/v1",
  "title": "Forge Runtime Routing Decision",
  "description": "Digest-bound, privacy-safe route selection evidence for one request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "policy_revision",
    "request_ref",
    "status",
    "candidates",
    "selected_route",
    "fallback_plan",
    "budget_state",
    "adaptation",
    "decision_ref"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_revision": {"const": "forge-routing-v1"},
    "policy_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["selected", "denied"]},
    "denial_reason": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "provider",
          "model",
          "status",
          "estimated_cost_usd",
          "estimated_latency_ms",
          "evidence"
        ],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "status": {"enum": ["eligible", "excluded"]},
          "reason_code": {"type": "string", "minLength": 1},
          "score": {"type": "number", "minimum": 0},
          "score_source": {"type": "string", "minLength": 1},
          "estimated_cost_usd": {"type": "number", "minimum": 0},
          "estimated_latency_ms": {"type": "integer", "minimum": 1},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sample_count", "quality_mean", "quality_lower_bound", "evidence_ref"],
            "properties": {
              "sample_count": {"type": "integer", "minimum": 0},
              "quality_mean": {"type": "number", "minimum": 0, "maximum": 1},
              "quality_lower_bound": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "oneOf": [
          {"properties": {"status": {"const": "eligible"}, "score": {"type": "number"}, "score_source": {"type": "string"}}, "required": ["score", "score_source"]},
          {"properties": {"status": {"const": "excluded"}, "reason_code": {"type": "string"}}, "required": ["reason_code"]}
        ]
      }
    },
    "selected_route": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["route_id", "provider", "model", "estimated_cost_usd", "estimated_latency_ms"],
          "properties": {
            "route_id": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "estimated_cost_usd": {"type": "number", "minimum": 0},
            "estimated_latency_ms": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "fallback_plan": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "current_concurrency", "policy_budgets"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "current_concurrency": {"type": "integer", "minimum": 1},
        "policy_budgets": {"$ref": "#/$defs/budgets"},
        "selected_estimated_cost_usd": {"type": "number", "minimum": 0},
        "selected_estimated_latency_ms": {"type": "integer", "minimum": 1}
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requested_mode", "disabled_by_request"],
      "properties": {
        "mode": {"enum": ["static", "adaptive", "disabled"]},
        "requested_mode": {"enum": ["static", "adaptive", "disabled"]},
        "disabled_by_request": {"type": "boolean"}
      }
    },
    "decision_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_cost_usd", "max_latency_ms", "max_concurrency"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_latency_ms": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1}
      }
    }
  }
}
