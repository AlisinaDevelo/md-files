{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlisinaDevelo/md-files/schema/runtime/receipts/v1",
  "title": "Forge Runtime Receipt Envelope",
  "description": "Deterministic, reference-only receipt bound to a runtime parent and digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_type",
    "run_id",
    "task_id",
    "source",
    "effect_id",
    "provider_idempotency_key",
    "attempt_id",
    "attempt",
    "lease_generation",
    "adapter_contract_revision",
    "provider_request_ref",
    "status",
    "occurred_at",
    "payload",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "format": "uuid"},
    "receipt_type": {"enum": ["effect.outcome", "effect.receipt", "policy.decision", "adapter.outcome"]},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"], "minLength": 1},
    "source": {"type": "object"},
    "effect_id": {"type": ["string", "null"]},
    "provider_idempotency_key": {"type": ["string", "null"]},
    "attempt_id": {"type": ["string", "null"]},
    "attempt": {"type": ["integer", "null"], "minimum": 1},
    "lease_generation": {"type": ["integer", "null"], "minimum": 1},
    "adapter_contract_revision": {"type": ["string", "null"], "minLength": 1},
    "provider_request_ref": {"type": ["string", "null"], "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "parent_receipt_id": {"type": "string", "format": "uuid"},
    "receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
