{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlisinaDevelo/md-files/schema/runtime/authority/v1",
  "title": "Forge Identity and Delegated Authority Bundle",
  "description": "Digest-bound offline authority evidence. Authentication is performed by a host or an explicit local trust boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_revision", "identities", "delegations", "action", "authorization", "approval"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_revision": {"const": "forge-authority-v1"},
    "identities": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/identity"}},
    "delegations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/delegation"}},
    "action": {"$ref": "#/$defs/action"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "approval": {"$ref": "#/$defs/approval"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaque": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}:[A-Za-z0-9][A-Za-z0-9._:/@-]{0,191}$"},
    "nonce": {"type": "string", "pattern": "^nonce:[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "algorithm", "key_id", "payload_digest"],
      "properties": {
        "mode": {"enum": ["external-reference", "local"]},
        "algorithm": {"enum": ["ed25519", "jws", "dpop", "spiffe-svid", "hmac-sha256"]},
        "key_id": {"type": "string", "pattern": "^key:[A-Za-z0-9][A-Za-z0-9._:/@-]{0,127}$"},
        "payload_digest": {"$ref": "#/$defs/ref"},
        "signature": {"type": "string", "minLength": 1},
        "proof_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "kind", "profile", "issuer_ref", "subject_ref", "agent_ref",
        "build_ref", "audience_ref", "workspace_ref", "scopes", "resource_refs", "tool_refs", "intent_refs",
        "issued_at", "expires_at", "nonce", "revocation_ref", "policy_revision_ref", "generation", "legacy_principal", "proof"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"const": "forge-authority-v1"},
        "kind": {"const": "identity"},
        "profile": {"enum": ["authority-v1", "legacy-principal-v1"]},
        "issuer_ref": {"$ref": "#/$defs/opaque"},
        "subject_ref": {"$ref": "#/$defs/opaque"},
        "agent_ref": {"$ref": "#/$defs/opaque"},
        "build_ref": {"$ref": "#/$defs/ref"},
        "audience_ref": {"$ref": "#/$defs/opaque"},
        "workspace_ref": {"$ref": "#/$defs/opaque"},
        "scopes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "resource_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "tool_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "intent_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ref"}},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"$ref": "#/$defs/nonce"},
        "revocation_ref": {"$ref": "#/$defs/ref"},
        "policy_revision_ref": {"$ref": "#/$defs/ref"},
        "generation": {"type": "integer", "minimum": 1},
        "legacy_principal": {"anyOf": [{"$ref": "#/$defs/opaque"}, {"type": "null"}]},
        "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "kind", "delegation_id", "issuer_identity_ref", "subject_identity_ref",
        "parent_delegation_ref", "audience_ref", "workspace_ref", "scopes", "resource_refs", "tool_refs", "intent_refs",
        "issued_at", "expires_at", "nonce", "revocation_ref", "policy_revision_ref", "generation", "proof"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"const": "forge-authority-v1"},
        "kind": {"const": "delegation"},
        "delegation_id": {"$ref": "#/$defs/opaque"},
        "issuer_identity_ref": {"$ref": "#/$defs/ref"},
        "subject_identity_ref": {"$ref": "#/$defs/ref"},
        "parent_delegation_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "audience_ref": {"$ref": "#/$defs/opaque"},
        "workspace_ref": {"$ref": "#/$defs/opaque"},
        "scopes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "resource_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "tool_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaque"}},
        "intent_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/ref"}},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"$ref": "#/$defs/nonce"},
        "revocation_ref": {"$ref": "#/$defs/ref"},
        "policy_revision_ref": {"$ref": "#/$defs/ref"},
        "generation": {"type": "integer", "minimum": 1},
        "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "kind", "actor_identity_ref", "authority_ref", "audience_ref",
        "workspace_ref", "capability", "resource_ref", "tool_ref", "effect_ref", "intent_ref", "policy_decision_ref",
        "approval_ref", "runtime_episode_ref", "provider_operation_ref", "provenance_ref", "lease_ref", "delegation_generation",
        "issued_at", "expires_at", "nonce", "proof"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"const": "forge-authority-v1"},
        "kind": {"const": "action"},
        "actor_identity_ref": {"$ref": "#/$defs/ref"},
        "authority_ref": {"$ref": "#/$defs/ref"},
        "audience_ref": {"$ref": "#/$defs/opaque"},
        "workspace_ref": {"$ref": "#/$defs/opaque"},
        "capability": {"$ref": "#/$defs/opaque"},
        "resource_ref": {"$ref": "#/$defs/opaque"},
        "tool_ref": {"$ref": "#/$defs/opaque"},
        "effect_ref": {"$ref": "#/$defs/opaque"},
        "intent_ref": {"$ref": "#/$defs/ref"},
        "policy_decision_ref": {"$ref": "#/$defs/ref"},
        "approval_ref": {"$ref": "#/$defs/ref"},
        "runtime_episode_ref": {"$ref": "#/$defs/ref"},
        "provider_operation_ref": {"$ref": "#/$defs/ref"},
        "provenance_ref": {"$ref": "#/$defs/ref"},
        "lease_ref": {"$ref": "#/$defs/ref"},
        "delegation_generation": {"type": "integer", "minimum": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"$ref": "#/$defs/nonce"},
        "proof": {"$ref": "#/$defs/proof"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "kind", "decision", "action_ref", "actor_identity_ref", "authority_ref",
        "audience_ref", "workspace_ref", "capability", "resource_ref", "policy_revision_ref", "approval_ref", "lease_ref",
        "delegation_generation", "expires_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"const": "forge-authority-v1"},
        "kind": {"const": "authorization"},
        "decision": {"enum": ["allow", "require_approval"]},
        "action_ref": {"$ref": "#/$defs/ref"},
        "actor_identity_ref": {"$ref": "#/$defs/ref"},
        "authority_ref": {"$ref": "#/$defs/ref"},
        "audience_ref": {"$ref": "#/$defs/opaque"},
        "workspace_ref": {"$ref": "#/$defs/opaque"},
        "capability": {"$ref": "#/$defs/opaque"},
        "resource_ref": {"$ref": "#/$defs/opaque"},
        "policy_revision_ref": {"$ref": "#/$defs/ref"},
        "approval_ref": {"$ref": "#/$defs/ref"},
        "lease_ref": {"$ref": "#/$defs/ref"},
        "delegation_generation": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "contract_revision", "kind", "status", "action_ref", "actor_identity_ref", "authority_ref",
        "approver_ref", "audience_ref", "workspace_ref", "capability", "resource_ref", "policy_revision_ref", "lease_ref", "delegation_generation", "expires_at"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "contract_revision": {"const": "forge-authority-v1"},
        "kind": {"const": "approval"},
        "status": {"enum": ["approved", "not-required"]},
        "action_ref": {"$ref": "#/$defs/ref"},
        "actor_identity_ref": {"$ref": "#/$defs/ref"},
        "authority_ref": {"$ref": "#/$defs/ref"},
        "approver_ref": {"$ref": "#/$defs/opaque"},
        "audience_ref": {"$ref": "#/$defs/opaque"},
        "workspace_ref": {"$ref": "#/$defs/opaque"},
        "capability": {"$ref": "#/$defs/opaque"},
        "resource_ref": {"$ref": "#/$defs/opaque"},
        "policy_revision_ref": {"$ref": "#/$defs/ref"},
        "lease_ref": {"$ref": "#/$defs/ref"},
        "delegation_generation": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
