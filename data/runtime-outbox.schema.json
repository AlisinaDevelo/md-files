{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlisinaDevelo/md-files/schema/runtime/outbox/v1",
  "title": "Forge Runtime Outbox Intent",
  "description": "A versioned, hash-bound intent for an at-least-once external effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "effect_id",
    "run_id",
    "source_event_id",
    "effect_type",
    "task_id",
    "activity_id",
    "activity_attempt",
    "effect_definition_revision",
    "idempotency_key",
    "effect_hash",
    "payload",
    "status",
    "available_at",
    "created_at",
    "updated_at",
    "delivery_attempts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "effect_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "format": "uuid"},
    "effect_type": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "activity_id": {"type": "string", "minLength": 1},
    "activity_attempt": {"type": "integer", "minimum": 1},
    "effect_definition_revision": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "effect_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "status": {"enum": ["pending", "leased", "retry", "succeeded", "dead_letter"]},
    "available_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "delivery_attempts": {"type": "integer", "minimum": 0},
    "last_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "lease_owner": {"type": ["string", "null"], "minLength": 1},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "last_error_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
