{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlisinaDevelo/md-files/schema/runtime/outbox/v1",
  "title": "Forge Runtime Outbox Intent",
  "description": "A versioned, hash-bound intent for an at-least-once external effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "effect_id",
    "run_id",
    "source_event_id",
    "effect_type",
    "task_id",
    "activity_id",
    "activity_attempt",
    "effect_definition_revision",
    "idempotency_key",
    "effect_hash",
    "payload",
    "status",
    "available_at",
    "created_at",
    "updated_at",
    "delivery_attempts",
    "lease_generation",
    "lease"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "effect_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "format": "uuid"},
    "effect_type": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "activity_id": {"type": "string", "minLength": 1},
    "activity_attempt": {"type": "integer", "minimum": 1},
    "effect_definition_revision": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "effect_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"},
    "status": {"enum": ["pending", "leased", "retry", "succeeded", "dead_letter"]},
    "available_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "delivery_attempts": {"type": "integer", "minimum": 0},
    "last_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "lease_owner": {"type": ["string", "null"], "minLength": 1},
    "lease_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "lease_generation": {"type": "integer", "minimum": 0},
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner",
        "generation",
        "started_at",
        "expires_at",
        "deadline_at",
        "lease_seconds",
        "max_lease_seconds",
        "heartbeat_seconds",
        "last_heartbeat_at",
        "heartbeat_count",
        "policy_revisions"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "owner": {"type": ["string", "null"], "minLength": 1},
        "generation": {"type": "integer", "minimum": 0},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "deadline_at": {"type": ["string", "null"], "format": "date-time"},
        "lease_seconds": {"type": ["integer", "null"], "minimum": 1},
        "max_lease_seconds": {"type": ["integer", "null"], "minimum": 1},
        "heartbeat_seconds": {"type": ["integer", "null"], "minimum": 1},
        "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
        "heartbeat_count": {"type": "integer", "minimum": 0},
        "policy_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lease", "heartbeat", "activity_timeout", "cancellation", "retry"],
          "properties": {
            "lease": {"type": "string", "minLength": 1},
            "heartbeat": {"type": "string", "minLength": 1},
            "activity_timeout": {"type": "string", "minLength": 1},
            "cancellation": {"type": "string", "minLength": 1},
            "retry": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "last_error_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
